params {
    reference_files_dir = ""

    // optional parameters
    max_memory = null
    target_pdb = null

    //foldseek parameters
    foldseek_exhaustive_search = false
    foldseek_e = 10
    foldseek_alignment_type = 2
    foldseek_embedding_metric = "qtmscore"
    foldseek_c = 0
    foldseek_tmscore_threshold = 0
    foldseek_min_seq_id = 0.0
    foldseek_s = 9.5
    foldseek_prefilter_mode = 0 // 0: kmer/ungapped (foldseek easy-search default), 1: ungapped, 2: nofilter, 3: ungapped&gapped
    
    // hierarchical clustering parameters
    hierarchical_cyclic = false                          // Whether structures are cyclic
    hierarchical_similarity_method = "sequence"           // Options: sequence, rmsd, secondary_structure, interface_residues
    hierarchical_linkage_method = "average"              // Hierarchical clustering linkage method
    hierarchical_threshold = 2.0                        // Clustering threshold
    hierarchical_criterion = "distance"                 // Clustering criterion
    hierarchical_dssp_csv = null                        // Optional: for secondary_structure method
    hierarchical_interface_residues_csv = null          // Optional: for interface_residues method
    
    // required parameters
    query_pdb = null
    n_neighbors = null
    chains = null
    workflow_name = null
}
