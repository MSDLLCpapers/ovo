params {

    // optional parameters
    experiment = "designable"       // "designable" or "diverse"
    effort = "max"                  // "max" (200 steps) or "fast" (100 steps)
    num_designs = "5"               // random seeds will be 0..N-1
    ligandmpnn_run_parameters = ""
    ligand_file = null              // optional ligand structure file, referenced in input JSON as "FILE_<basename>"
    cyclic = false

    if (params.containsKey("reference_files_dir")) {
        // DISCO-specific HuggingFace cache used as HF_HOME. 
        // Pre-populated with DISCO-Design/DISCO and airkingbd/dplm_650m under hub/.
        hf_cache_path = "${params.reference_files_dir}/disco_models_hf_cache/"
        boltz_models_path = "${params.reference_files_dir}/boltz_models/"
    }

    // required parameters
    input_json = null               // Path to DISCO input JSON file
}
