
params {

    // required parameters
    // pdb_dir: Input path - .pdb file, .txt list of .pdb paths, or directory ending with /
    pdb_dir = null
    // binder_chain_id: Chain ID of the binder
    binder_chain_id = "A"
    // target_chain_id: Chain ID of the target
    target_chain_id = "B"

    // optional parameters
    batch_size = 50
}
