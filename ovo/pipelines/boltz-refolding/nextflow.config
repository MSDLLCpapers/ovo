
params {

    // optional parameters
    output_dir = "batch1"
    if (params.containsKey("reference_files_dir")) {
      boltz_models_path = "${params.reference_files_dir}/boltz_models/"
    }
    run_parameters = ""
    design_type = null
    native_pdb = null
    // Only used when running this pipeline standalone (local/unit tests); it names the
    // output subdirectory. In production, meta.test is passed in by refolding/main.nf.
    test = "boltz2"

    // required parameters
    input_dir = []
}
